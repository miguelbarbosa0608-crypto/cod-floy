# Copie para .env (local) e cadastre as mesmas variáveis na Netlify
# (Site configuration > Environment variables). Não coloque valores reais neste arquivo.
#
# São usadas só no servidor, pelo formulário de contato (src/lib/contact.functions.ts),
# para gravar os contatos na tabela contact_leads do Supabase. O build não precisa delas.

# Endereço do projeto Supabase (ex.: https://xxxxxxxx.supabase.co)
SUPABASE_URL=""
# Chave secreta (service_role) do Supabase: só no servidor, nunca no código nem com prefixo VITE_.
SUPABASE_SERVICE_ROLE_KEY=""
