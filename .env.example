# Copie para .env (local) e cadastre as mesmas variáveis na Netlify
# (Site configuration > Environment variables). Não coloque valores reais neste arquivo.

# Usadas pelo formulário de contato (servidor). OBRIGATÓRIAS para o formulário funcionar.
SUPABASE_URL=""
# Chave secreta (service_role) do Supabase: só no servidor, nunca no código nem com prefixo VITE_.
SUPABASE_SERVICE_ROLE_KEY=""

# Chave pública e ID do projeto (reservadas para recursos futuros do Supabase no site).
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""
